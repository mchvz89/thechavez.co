---
import BaseLayout from '../layouts/BaseLayout.astro';

const skillGroups = [
  {
    category: 'Cloud & Identity',
    skills: ['Microsoft Entra ID', 'Conditional Access', 'PIM', 'Azure AD B2B/B2C', 'M365 Admin Center', 'Defender for Identity'],
  },
  {
    category: 'Infrastructure',
    skills: ['WatchGuard NGFW & EDR', 'UniFi Wireless', 'Hyper-V', 'VLANs & 802.1Q', 'VPN (Site-to-Site & Remote)', 'DNS & DHCP'],
  },
  {
    category: 'Security',
    skills: ['Zero Trust Architecture', 'CIS Benchmarks', 'Email Security / Anti-Phishing', 'SpamTitan', 'Endpoint Protection', 'SC-300 (in progress)'],
  },
  {
    category: 'Home Lab & Tooling',
    skills: ['Synology DSM', 'Docker & Compose', 'Jellyfin / VAAPI', 'Proxmox', 'Network Monitoring', 'Media Automation'],
  },
];

const certifications = [
  { name: 'SC-300: Identity & Access Administrator',                  status: 'pursuing' },
  { name: 'AZ-104: Microsoft Azure Administrator',                    status: 'earned'   },
  { name: 'SC-900: Security, Compliance & Identity Fundamentals',     status: 'earned'   },
  { name: 'MS-500: Microsoft 365 Security Administration',            status: 'earned'   },
  { name: 'CompTIA Network+',                                         status: 'earned'   },
  { name: 'CompTIA A+',                                               status: 'earned'   },
];
---

<BaseLayout
  title="About"
  description="8 years keeping infrastructure running. Now focused on making sure it can't be broken into. IT engineer transitioning into cybersecurity — Zero Trust, identity, and Microsoft Azure."
>
  <div class="container mx-auto py-16 max-w-4xl">

    <!-- ─── Header ──────────────────────────────────────────── -->
    <div class="mb-12">
      <p class="font-mono text-site-blue text-sm mb-4">~/about</p>
      <h1 class="text-4xl md:text-5xl font-bold text-site-text mb-4">Miguel Chavez</h1>
      <p class="font-mono text-site-muted text-base md:text-lg">
        IT Infrastructure Engineer <span class="text-site-amber">→</span> Cybersecurity
      </p>
    </div>

    <!-- ─── Bio ─────────────────────────────────────────────── -->
    <section class="mb-16 space-y-4 text-site-muted leading-relaxed max-w-2xl">
      <p class="text-site-text">
        I've spent 8 years keeping other people's infrastructure running.
        Now I'm focused on making sure it can't be broken into.
      </p>
      <p>
        All of that time was spent in the Cayman Islands, one of the world's leading offshore financial
        centers, managing IT infrastructure for organizations across financial services, legal, and
        professional sectors. Working in an MSP meant owning the full stack for multiple clients
        simultaneously, with operations and teams spanning the United States, the Philippines, and
        across Asia. High-stakes environments, tight compliance expectations, and no redundancy of teams
        to fall back on.
      </p>
      <p>
        In practice, that meant WatchGuard NGFW and EDR deployments, M365 tenant hardening against Secure
        Score benchmarks, email threat protection with SpamTitan, complete migrations from legacy
        systems to Microsoft 365, and VPN infrastructure for distributed teams. The MS-500, AZ-104,
        and SC-900 are the certifications that reflect that work.
      </p>
      <p>
        What drew me to this field, and keeps me here, is the puzzle. Every network is different,
        every client has a unique risk profile, and the threat landscape shifts faster than the tools do.
        That friction is what I find interesting.
      </p>
      <p>
        Outside of work: Synology NAS, Docker, 10GbE networking, and more home lab experiments than I
        should probably admit to. It's where infrastructure ideas get tested before they're trusted.
      </p>
    </section>

    <!-- ─── What I'm working toward ────────────────────────── -->
    <section class="mb-16">
      <h2 class="text-xl font-bold text-site-text mb-6">What I'm Working Toward</h2>
      <div class="max-w-2xl border-l-2 border-site-amber pl-6 space-y-4">
        <p class="text-site-muted leading-relaxed">
          I'm actively pursuing roles in cybersecurity, specifically in identity, access management,
          and Zero Trust architecture. The SC-300 is the current certification milestone, but the
          real goal is moving from "the person who secures the infrastructure" to "the person who
          designs the security posture from the ground up."
        </p>
        <p class="text-site-muted leading-relaxed">
          If you're building something in that space, or just want to compare notes on Conditional
          Access edge cases, I'd love to talk.
        </p>
        <a href="/contact" class="inline-flex items-center gap-1 text-sm text-site-blue hover:text-site-amber transition-colors font-medium pt-1">
          Get in touch →
        </a>
      </div>
    </section>

    <!-- ─── Certifications ───────────────────────────────────── -->
    <section class="mb-16">
      <h2 class="text-xl font-bold text-site-text mb-8">Certifications</h2>
      <div class="flex flex-col gap-3 max-w-xl">
        {certifications.map(({ name, status }) => (
          <div class="flex items-center justify-between bg-site-surface border border-site-edge rounded px-5 py-4 gap-4">
            <span class="text-sm text-site-text">{name}</span>
            <span class={`shrink-0 text-xs font-mono px-2 py-0.5 rounded border ${
              status === 'earned'
                ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
                : 'bg-site-amber/10 text-site-amber border-site-amber/20'
            }`}>
              {status === 'earned' ? 'Earned' : 'In Progress'}
            </span>
          </div>
        ))}
      </div>
      <p class="text-xs text-site-muted mt-4">
        Also holds: MCSA Windows 8, MCITP Windows 7, Windows Server 2012 R2, Ruckus WiSE, Apple Certified Associate, 25+ Dell certifications.
      </p>
    </section>

    <!-- ─── Skills ──────────────────────────────────────────── -->
    <section class="mb-16">
      <h2 class="text-xl font-bold text-site-text mb-8">Technical Skills</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        {skillGroups.map(({ category, skills }) => (
          <div>
            <h3 class="text-xs font-mono text-site-muted uppercase tracking-widest mb-4">{category}</h3>
            <div class="flex flex-wrap gap-2">
              {skills.map(skill => (
                <span class="text-sm px-3 py-1 rounded bg-site-surface border border-site-edge text-site-text">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── Education ────────────────────────────────────────── -->
    <section>
      <h2 class="text-xl font-bold text-site-text mb-8">Education</h2>
      <div class="bg-site-surface border border-site-edge rounded px-5 py-4 max-w-xl">
        <p class="text-sm font-medium text-site-text">B.S. Computer Science</p>
        <p class="text-sm text-site-muted mt-0.5">University of the People · In Progress</p>
      </div>
    </section>

  </div>
</BaseLayout>
