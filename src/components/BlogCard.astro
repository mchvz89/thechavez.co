---
interface Props {
  title:       string;
  description: string;
  pubDate:     Date;
  slug:        string;
  tags:        string[];
}

const { title, description, pubDate, slug, tags } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year:  'numeric',
  month: 'long',
  day:   'numeric',
});
---

<article class="bg-site-surface border border-site-edge rounded p-6 flex flex-col gap-3 hover:border-site-blue/50 transition-colors group">
  <div class="flex flex-wrap gap-2">
    {tags.map(tag => (
      <span class="text-xs font-mono px-2 py-0.5 rounded bg-site-blue/10 text-site-blue border border-site-blue/20">
        {tag}
      </span>
    ))}
  </div>

  <h3 class="text-base font-semibold text-site-text leading-snug group-hover:text-site-blue transition-colors">
    <a href={`/blog/${slug}`} class="stretched-link">{title}</a>
  </h3>

  <p class="text-site-muted text-sm leading-relaxed line-clamp-2 flex-1">{description}</p>

  <div class="flex items-center justify-between pt-1">
    <time class="text-xs text-site-muted font-mono">{formattedDate}</time>
    <span class="text-xs text-site-blue font-medium">Read more →</span>
  </div>
</article>
