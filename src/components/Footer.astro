---
const year = new Date().getFullYear();
---

<footer class="border-t border-site-edge mt-auto py-10">
  <div class="container mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="text-site-muted text-sm">© {year} Miguel Chavez</p>

    <p class="text-site-muted text-xs text-center hidden md:block">
      Building secure systems. Documenting everything.
    </p>

    <div class="flex items-center gap-6">
      <a
        href="#"
        aria-label="GitHub"
        class="text-site-muted hover:text-site-blue text-sm transition-colors"
      >
        GitHub
      </a>
      <a
        href="#"
        aria-label="LinkedIn"
        class="text-site-muted hover:text-site-blue text-sm transition-colors"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>
